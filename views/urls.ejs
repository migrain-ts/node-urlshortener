<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Qahiri&display=swap" rel="stylesheet">
    <title>URL Shortener</title>
</head>

<body>
    <nav style="padding-left: 5px; background: black">
        <div class="nav-wrapper container">
            <ul id="nav-mobile" class="hide-on-med-and-down">
                <li><a href="/">Home</a></li>
                <li><a href="urls">Urls</a></li>
            </ul>
        </div>
    </nav>
    <div class="container center">
        <h1 style="font-family: 'Qahiri', sans-serif;">URL Shortener</h1>
        <form action="/shortUrls" method="POST">
            <label for="fullUrl" class="hide" style="font-family: 'Qahiri', sans-serif;">URL</label>
            <input required placeholder="URL" type="text" name="fullUrl" id="fullUrl">
            <button type="submit" class="btn btn-large black" style="margin-top: 50px;">Generate</button>
        </form>

        <table class="striped centered" style="margin-top: 50px">
            <thead>
                <tr>
                    <th>Full URL</th>
                    <th>Short URL</th>
                    <th>Clique</th>
                </tr>
            </thead>
            <tbody>
                <% shortUrls.forEach(shortUrl => { %>
                    <tr>
                        <td>
                            <a href="<%= shortUrl.full %>">
                                <%= shortUrl.full %>
                            </a>
                        </td>
                        <td>
                            <a href="<%= shortUrl.short %>">
                                <%= shortUrl.short %>
                            </a>
                        </td>
                        <td>
                            <%= shortUrl.clicks %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>


    <footer class="page-footer black" style="margin-top: 100px;">
        <div class="container">
            <div class="row">
                <div class="col l6 s12">
                    <h5 class="white-text">Short URL</h5>
                    <p class="grey-text text-lighten-4">I built this project to practice my NodeJS skills. It auto generates an express route and automatically redirects to the full URL.</p>


                </div>
                <div class="col l3 s12">

                </div>
                <div class="col l3 s12">
                    <h5 class="white-text center">Pages</h5>
                    <ul class="center">
                        <li><a class="white-text" href="/">Home</a></li>
                        <li><a class="white-text" href="/urls">Urls</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-copyright center">
            <div class="container">
                &copy; dl3c01n
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>

</html>